# ─────────────────────────────────────────────
#  مثال لملف البيئة - انسخه إلى .env وعدّل القيم
#  cp .env.example .env
#  ملف .env مستثنى من Git ولا يجب رفعه إطلاقاً
# ─────────────────────────────────────────────

# مفتاح سري عشوائي بطول 50 حرفاً على الأقل
# للتوليد:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# أسماء النطاقات المسموح بها (مفصولة بفاصلة، بلا مسافات)
DJANGO_ALLOWED_HOSTS=sec.internal.example.com

# أصول موثوق بها لـ CSRF (يجب أن تبدأ بـ https://)
CSRF_TRUSTED_ORIGINS=https://sec.internal.example.com

# 0 في الإنتاج - لا تغيّرها إلى 1 على خادم حقيقي
DJANGO_DEBUG=0

# ──── قاعدة البيانات ────
DB_NAME=sec_db
DB_USER=sec_user
# استخدم كلمة مرور قوية ومختلفة عن كل الأنظمة الأخرى
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
